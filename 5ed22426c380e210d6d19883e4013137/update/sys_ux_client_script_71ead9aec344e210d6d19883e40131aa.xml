function handler({api, event, helpers, imports}) {
var listArr = [];
var companies = api.data.getBuffaloCustomers;

for(var i = 0; i < companies.length; i++){
    var obj = {
        id:companies[i]._row_data.uniqueValue,
        label:companies[i]._row_data.displayValue
    };
    listArr.push(obj);
}
console.log(listArr);
api.setState("companyArr", listArr);
}]]></script>
